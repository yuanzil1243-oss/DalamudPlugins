<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../LocalExtensions/Host/ForcedMovement/*.cs" Exclude="../../LocalExtensions/Host/ForcedMovement/NativeDefinitions.generated.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../LocalExtensions/Core/AntiDisplacement/Policy.cs" Link="Production/DisplacementPolicy.cs" />
  </ItemGroup>
</Project>
