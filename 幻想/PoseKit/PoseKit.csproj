<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>2.2.0.9</Version>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>Rayla Petal / yuanzil1243-oss</Author>
    <Name>PoseKit（简体中文）</Name>
    <Punchline>浏览、调整、保存和配对播放姿势。</Punchline>
    <Description>PoseKit 简体中文界面：浏览 Penumbra 动画、调整姿势偏移、保存预设、配对播放和骨骼对齐。</Description>
    <RepoUrl>https://github.com/RaylaPetal/PoseKit</RepoUrl>
    <Tags>pose;emote;offset;penumbra</Tags>
  </PropertyGroup>
  <ItemGroup>
    <!-- Built from source: the published Penumbra.Api package references an assembly name the
         published Luna package doesn't provide. -->
    <ProjectReference Include="..\Penumbra.Api\Penumbra.Api.csproj" />
    <ProjectReference Include="..\Luna\Luna\Luna.csproj" />
    <ProjectReference Include="..\Luna\Luna.Generators\Luna.Generators.csproj" OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
